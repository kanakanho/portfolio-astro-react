{
  "name": "kanakanho-portfolio-by-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm fetch-post-images && astro dev",
    "start": "pnpm fetch-post-images && astro dev",
    "build": "pnpm fetch-post-images && astro check && astro build",
    "fetch-post-images": "node scripts/fetch-post-images.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "biome": "biome check --write ./src && biome format --write ./src && prettier --write ./src",
    "lint": "biome check --write ./src",
    "format": "biome format --write ./src && prettier --write ./src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/react": "^7.1.0",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@astrojs/partytown": "^2.1.8",
    "@biomejs/biome": "^2.5.15",
    "@chromatic-com/storybook": "^5.5.1",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-expressive-code": "^0.44.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "sass": "^1.105.2",
    "storybook": "^10.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
